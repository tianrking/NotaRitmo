COMPOSE_PROJECT_NAME=meeting-agent

MEETING_API_PORT=4200
TEMPORAL_UI_PORT=8233
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_USER=meeting
POSTGRES_PASSWORD=change-meeting-password
POSTGRES_DB=meeting
DATABASE_URL=postgresql+psycopg://meeting:change-meeting-password@postgres:5432/meeting

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=meeting-minio
MINIO_SECRET_KEY=change-minio-password
MINIO_BUCKET=meeting-audio
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1
UPLOAD_URL_TTL_SECONDS=3600
AUDIO_MAX_BYTES=6442450944
AUDIO_MAX_DURATION_SECONDS=21600
AUDIO_PREPROCESS_VERSION=ffmpeg-v1
AUDIO_DENOISE_DEFAULT=false
SPEAKER_EMBEDDING_ENABLED=true
SPEAKER_EMBEDDING_MODEL=/models/speaker/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
SPEAKER_EMBEDDING_MODEL_VERSION=3dspeaker-campplus-16k-v1
SPEAKER_EMBEDDING_DIMENSIONS=192
SPEAKER_EMBEDDING_THREADS=2
SPEAKER_MATCH_THRESHOLD=0.62
SPEAKER_MIN_ENROLLMENT_MS=3000
SPEAKER_MAX_SAMPLE_MS=60000

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=meeting-ingest

DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
PUBLIC_API_BASE_URL=http://localhost:4200
PROVIDER_AUDIO_SECRET=change-provider-audio-secret
PROVIDER_AUDIO_URL_TTL_SECONDS=86400
HERA_AUTH_REQUIRED=false
HERA_SIGNING_SECRET=change-hera-signing-secret
HERA_SIGNATURE_MAX_SKEW_SECONDS=300
HERA_OUTBOX_SCHEMA_VERSION=hera-meeting-intelligence-v1

TINGWU_ENABLED=false
TINGWU_APP_KEY=
TINGWU_REGION=cn-beijing
TINGWU_DOMAIN=tingwu.cn-beijing.aliyuncs.com
TINGWU_SOURCE_LANGUAGE=cn
TINGWU_POLL_SECONDS=60
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

LLM_ENABLED=false
LLM_BASE_URL=http://host.docker.internal:4000/v1
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=openai-compatible
LLM_PROMPT_VERSION=meeting-unified-v1
LLM_SCHEMA_VERSION=meeting-components-v1
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_MAX_TRANSCRIPT_CHARACTERS=240000
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDINGS_ENABLED=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_CACHE=/models/fastembed

GRAPHITI_ENABLED=false
GRAPH_MEMORY_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-neo4j-password
