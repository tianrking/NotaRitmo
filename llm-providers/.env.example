# 默认安全模式：不联网，不需要 API Key
LLM_PROVIDER=offline
LLM_API_STYLE=offline
LLM_MODEL=fixture

# 选择远程 OpenAI-compatible 时，取消注释并在本地 shell 注入密钥。
# LLM_PROVIDER=openai-compatible
# LLM_API_STYLE=openai
# LLM_BASE_URL=https://api.example.com
# LLM_MODEL=your-model
# LLM_API_KEY=

# 选择用户当前的 BigModel Anthropic-compatible 路由时：
# 只填写占位符，不要把真实 token 写进文件、日志或 Git。
# LLM_PROVIDER=anthropic-compatible
# LLM_API_STYLE=anthropic
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=glm-5.2

# 通用传输策略
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=0.25
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0
LLM_JSON_MODE=1

# 可选成本记录（每百万 token，未配置时 cost_usd=null）
# LLM_INPUT_USD_PER_1M=
# LLM_OUTPUT_USD_PER_1M=
